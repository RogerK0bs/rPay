        <Label FontSize="15" HorizontalContentAlignment="Center" BorderThickness="2" BorderBrush="Aqua" Content="" x:Name="qrId" HorizontalAlignment="Left" Height="41" Margin="54,10,0,0" VerticalAlignment="Top" Width="307"/>

    </Grid>
