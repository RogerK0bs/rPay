        <Label FontSize="20" HorizontalContentAlignment="Center" Content="Статус платежа:" HorizontalAlignment="Left" Height="40" Margin="54,117,0,0" VerticalAlignment="Top" Width="151"/>
        <Label FontSize="20" HorizontalContentAlignment="Center" Content="Сумма:" HorizontalAlignment="Left" Height="36" Margin="54,158,0,0" VerticalAlignment="Top" Width="151"/>
        <Button x:Name="updateStatus" FontSize="20" Content="Обновить"  HorizontalAlignment="Center" Height="39" Margin="0,269,0,0" VerticalAlignment="Top" Width="152" Click="updateStatus_Click"/>
        <Label FontSize="20" HorizontalContentAlignment="Center" BorderBrush="Bisque" BorderThickness="2" Content="" x:Name="numberPacient" HorizontalAlignment="Left" Height="40" Margin="210,72,0,0" VerticalAlignment="Top" Width="151"/>
        <Label FontSize="20" HorizontalContentAlignment="Center" BorderBrush="Bisque" BorderThickness="2" Content="" x:Name="statusPay" HorizontalAlignment="Left" Height="40" Margin="210,117,0,0" VerticalAlignment="Top" Width="151"/>
