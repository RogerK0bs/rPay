<Window x:Class="rPay.Windows.listStatusDQR"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:rPay.Windows"
        mc:Ignorable="d"
        Title="listStatusDQR" Height="530" MaxHeight="530" MinHeight="530" Width="520" MinWidth="520" MaxWidth="520">
    <Grid>
        <ListBox x:Name="listQR" HorizontalAlignment="Left" Height="380" Margin="10,0,0,0" VerticalAlignment="Center" Width="500" d:ItemsSource="{d:SampleData ItemCount=10}"/>
        <Button x:Name="update" Content="Обновить список"  FontSize="14" HorizontalAlignment="Left" Height="25" Margin="198,447,0,0" VerticalAlignment="Top" Width="137" Click="update_Click"/>
        <Button x:Name="checkPay" Content="Проверить платёж" FontSize="14" HorizontalAlignment="Left" Height="25" Margin="340,447,0,0" VerticalAlignment="Top" Width="137" Click="checkPay_Click"/>
        <Label x:Name="numPay" Content="" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Height="25" Margin="10,447,0,0" VerticalAlignment="Top" Width="49"/>
    </Grid>
</Window>
